 "sample_rules": {
  "scenarios": {
   "id": "SR1",
   "version": 1,
   "complete_trusted_years": 3,
   "definition": "at least 3 consecutive years whose trust is VERIFIED and whose NAV dates equal the official calendar sessions of that year exactly"
  },
  "min_closed_trades_for_trade_statistics": 30,
  "min_common_sessions_portfolio": 252,
  "note": "methodology constants fixed before any new-run result; not performance thresholds. 30 closed trades: the common minimum for a normal approximation of a mean; it only decides whether trade statistics are called ADEQUATE, never a performance verdict"
 },
 "auxiliary": [
  "positive_year_share_stress: the former 50 percent rule, shown as an observation only",
  "participation: the engine enforces the 5 percent fill cap, so it is reported (P90, cap-binding share) and never judged"
 ],
