     "sha256": "1845aa6344c9a329f2e2110c8d8ae5a9e6e075a096629ce4c02ec74b37b1bd41"
    }
   ],
   "text": "規格需要 operating_income_yoy、eps_yoy 與 near_high_252d。開發輸入為 prepared_v6 的 bars.json、universe.json、actions.json，fundamental_pit_v3_2_verified 的 fundamental_matrix.parquet 與 fundamental_records.parquet，以及 G2/G3 因子結果 factor_result.json。"
  },
  "entry": {
   "sources": [
    {
     "ref": "core/research/strategy_signal.py::standardize",
     "sha256": "bca026c66b3d29b80d91ba305aa1ce571f97fbb4988041f038473edfc858c5bf"
    },
    {
     "ref": "core/research/strategy_signal.py::rebalance",
     "sha256": "eb8aa33c01f0e038904b36f60954ab471182f53a35114e3061c256e61551ba62"
    },
    {
     "ref": "core/research/h4_signal.py::SPEC",
     "sha256": "8d580b146ebd2cc8f48ea2a78f2176b3c9d7a994831f55edc4f1ac3854de5595"
    }
   ],
   "text": "入選前 10 名的股票在訊號日得到目標權重；相對上一期目標由 0 變正者標為 BUY。此程式只產生模擬的權重變化，不建立任何委託，發布為 DISABLED 且僅供研究；成交時點不在此程式中定義。"
  },
  "exit": {
   "sources": [
    {
     "ref": "core/research/strategy_signal.py::rebalance",
     "sha256": "eb8aa33c01f0e038904b36f60954ab471182f53a35114e3061c256e61551ba62"
    }
   ],
   "text": "沒有停損、停利或持有天數規則。上一期持有、本期目標權重為 0 的股票標為 SELL。"
  },
  "factors": {
   "sources": [
    {
     "ref": "scripts/prepare_h4_signals.py::score_components",
     "sha256": "0020b888760a6fb6fee50f6295bb7e37b395acd2b2fe1e1e18995e30cfaa2079"
    },
    {
