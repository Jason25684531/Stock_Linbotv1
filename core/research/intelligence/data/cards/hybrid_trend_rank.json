     "sha256": "583ddf3b291fe9be16e228bd7d4d0afff5e5726b40e3f3cb582c502e3eb29a10"
    },
    {
     "ref": "core/strategies/base.py::BaseStrategy._check_market_filter",
     "sha256": "5f475271cbf869f67de9dd5d96dec7b0775a5377eabf688acb580e454b843b09"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.process_close_signals",
     "sha256": "e4f0738b44d9a5f9a3331ae7641055228db124e2ef9dd0ecce4fbccf99202a13"
    },
    {
     "ref": "core/backtest/execution.py::fill_check",
     "sha256": "d9d2fbc40a99b8addb68bbedc542ddfb86ea8203c83276a6a39746fba7d435c4"
    },
    {
     "ref": "core/backtest/execution.py::CAP",
     "sha256": "ab4404270ab69a860857b768bc90339fc7c2ef2b83ad128e576576e848cbcfc3"
    }
   ],
   "text": "個股風控為初始停損 7%、停利 15%、最長持有 10 天與階梯式移動停損；策略內建大盤熔斷，引擎也只在大盤為 BULL 時進場；開盤漲停鎖死不買、跌停鎖死不賣；單筆成交不超過前一交易日成交金額的 5%。"
  },
