    {
     "ref": "scripts/native7_rules_only.py::SLIPPAGE_SEED",
     "sha256": "bde8476612a8454f8dd83d32481abafb7516fb16977e5056dbc1c5e7d5ebb07a"
    }
   ],
   "text": "買進手續費 = max(int(成交金額 × 0.001425), 20)；賣出手續費相同，另加證交稅 int(成交金額 × 0.003)（Config.FEE_RATE、Config.TAX_RATE、MIN_FEE）。滑價為每筆成交價朝不利方向偏移 0 至 0.1% 的均勻亂數（Config.SLIPPAGE_MAX_PIPS），亂數種子固定。壓力情境把費率、稅率、最低手續費與滑價上限全部乘以 2（STRESS_MULTIPLE）。"
  },
  "data_requirements": {
   "sources": [
    {
     "ref": "core/research/reference/catalog.py::capabilities",
     "sha256": "1845aa6344c9a329f2e2110c8d8ae5a9e6e075a096629ce4c02ec74b37b1bd41"
    },
    {
     "ref": "core/research/reference/catalog.py::NATIVE_NEEDS",
     "sha256": "2d43e7ef23b4f91b13fb95ef45c2a677871779c5421c1408bd5de521c2140d4a"
    },
    {
     "ref": "core/research/native_frame.py::rule_inputs",
     "sha256": "02d1adf456a1248edbdb0964691d8ce9b04b38aec67363e76fe7687fc43cb676"
    },
    {
     "ref": "core/backtest/runner.py::PAR_VALUE",
     "sha256": "ab48ab1be2e4afec519ab8ace3619d4d0141168cbcccd24517b09e26275f4a3e"
    },
    {
     "ref": "core/research/native_frame.py::FRAME_INPUTS",
