  "benchmark": {
   "sources": [
    {
     "ref": "scripts/historical_foundation.py::BENCHMARK",
     "sha256": "18f7a83f209f15c7f69b676c6f4414cd9e58fdf304ca05e655e506aa5a796e6f"
    }
   ],
   "text": "比較基準為臺灣證券交易所發行量加權股價報酬指數（MI_INDEX 列）；市場狀態分段使用價格指數。"
  },
