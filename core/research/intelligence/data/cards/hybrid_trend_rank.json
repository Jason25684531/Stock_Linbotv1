    },
    {
     "ref": "core/research/native_frame.py::NativeResearchData.frame",
     "sha256": "3ce86e434675a84475d911695a92e8575b6e318149fada890a5b0da7de428327"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine._apply_corporate_actions",
     "sha256": "96db81f9726fbc35ab890894197c720a2c866096457b5675a2e4372b52750378"
    },
    {
     "ref": "core/strategies/hybrid_trend_rank.py::HybridTrendRankStrategy.features",
     "sha256": "9bff5f1fabbb518a3e5a32e6736a79e31744fc2c1fbc6f8d75ce3eb1fa636adb"
    }
   ],
   "text": "引擎策略的資料需求為官方日線、T86 三大法人買賣超、MI_MARGN 融資餘額、財務報表、月營收、財報公告日與公司行動（catalog NATIVE_NEEDS）。本策略模組中出現的研究欄位（rule_inputs）為：bb_width、bias、foreign_ratio、kd_k、ma20、ma60、macd_hist、rsi、trust_ratio、volume_ratio（含 AI 特徵清單中的欄位，因此缺少外資或投信資料的股票也會被排除）；研究橫截面中任一欄位缺值的股票會被排除並記錄原因。持股期間的除權息、減資等公司行動在當日開盤成交前記入持股：股數乘以 share_multiplier 取整、現金配發與零股（以面額 10 元結算）記入現金、成本與停損價依 price_factor 調整。"
  },
  "entry": {
   "sources": [
    {
     "ref": "core/backtest/runner.py::BacktestEngine.process_close_signals",
     "sha256": "e4f0738b44d9a5f9a3331ae7641055228db124e2ef9dd0ecce4fbccf99202a13"
    },
    {
     "ref": "core/db_helper.py::get_market_trend",
     "sha256": "532a5b4d31011ea4116811eceb7c0b3e13b8ace960b779eda24703f1e66ddef8"
    },
    {
     "ref": "config/settings.py::Config.MARKET_SYMBOL",
     "sha256": "e46cc929614e6dde0fe3577d1be745300625d7a0bf0fd9324cca4db5f51bbf20"
    },
    {
     "ref": "scripts/legacy_baseline_run.py::EXECUTION_CONTRACT",
     "sha256": "79431a09450b909627f43e1569805f1ac8ea02dadd5f20ca20b6de63402bb8fd"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.execute_pending_open",
     "sha256": "bf05cceee31f3f6a56ec1793eac5b6cf8f7945a1693d358a5de0b7c9c8d65bb5"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine._open_fill_rejection",
     "sha256": "80aaab55d435f5cbd00231db5c6fc7fd361aa2719e4971469195bbe74ab508f4"
    },
    {
     "ref": "core/backtest/execution.py::fill_check",
     "sha256": "d9d2fbc40a99b8addb68bbedc542ddfb86ea8203c83276a6a39746fba7d435c4"
    },
    {
     "ref": "core/backtest/execution.py::limit_prices",
     "sha256": "dcdb2ecf979476e3557c19a39bbbff411fcc260d0f0e0568c295bdf892782752"
    }
   ],
   "text": "引擎每個交易日收盤先處理出場，只有在大盤趨勢標籤為 BULL 時才呼叫選股。BULL 的定義是 Config.MARKET_SYMBOL（2330）當日收盤價高於其 MA60 的 0.95 倍，否則為 BEAR。候選股中尚未持有者以買單在下一個交易日開盤成交（執行契約 next_session_open_v2）。下一交易日開盤價缺漏或無效時買單作廢；前一交易日沒有有效官方收盤價（漲跌停價無法計算）、當日無成交，或開盤即漲停鎖死（開盤 = 最高 = 最低且開盤 ≥ 漲停價）時拒絕成交。"
  },
  "exit": {
   "sources": [
    {
     "ref": "core/strategies/base.py::BaseStrategy.check_exit_signal",
     "sha256": "583ddf3b291fe9be16e228bd7d4d0afff5e5726b40e3f3cb582c502e3eb29a10"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.check_and_execute_exit",
     "sha256": "de4e85bc4c258f17e5c1ec3aca7be67b4841db2bbfe2603242e9bf543e3a7cf5"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine._exit_at_signal",
     "sha256": "23f6c8426e2f62adbd5cc2f9bfdc4bce3973bbb313227b4cb94d482dd0e94679"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine._load_params",
     "sha256": "6368f94392e247915e4724884ffa67084f56a8394fb302d651b12f5e3f61f031"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.buy",
     "sha256": "80eac68203c705a89bf7c73158c5cc2c4bb182aa01ae98c50225d7e1889a1500"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.sell",
     "sha256": "839ec42058aad50ee799849ae06e6fe0764526fe85e9919c38114f3b44a8913a"
    },
    {
     "ref": "core/strategies/hybrid_trend_rank.py::HybridTrendRankStrategy.stop_loss",
     "sha256": "f67691c33bac5cda21084eac893028089288dfe36d4f24ed7f8ba448a00b78c7"
    },
    {
     "ref": "core/strategies/hybrid_trend_rank.py::HybridTrendRankStrategy.take_profit",
     "sha256": "87b5e3d124256ff4a8806f7dbbd3b38ad39c1a3d97857cb449b4e1680e8b1ae6"
    },
    {
     "ref": "core/strategies/hybrid_trend_rank.py::HybridTrendRankStrategy.max_hold_days",
     "sha256": "b0d1d636a6452015569f0d0e6047197f9899a5f3e21589fb36840919d9ca9314"
    }
   ],
   "text": "停損 7%、停利 15%、最長持有 10 天，三者都寫死在策略屬性中，不讀設定。引擎在每個交易日收盤先把持有天數加 1，再以當日收盤價判斷出場；當日無行情時不判斷。買進時初始停損價為成交當日開盤價乘以（1 − 停損比例）。階梯式移動停損：收盤報酬達 30% 時停損價上移至成本 × 1.25，達 20% 時上移至成本 × 1.15，達 10% 時上移至成本 × 1.01，停損價只上移不下移。賣出條件依序為：收盤價 ≤ 停損價（停損）、報酬 ≥ 停利比例（停利）、持有天數 ≥ 最長持有天數（時間到）、大盤趨勢為 BEAR 且報酬為負（趨勢轉空）。出場訊號以賣單在下一個交易日開盤執行；賣單被拒絕或只部分成交時，剩餘持股保留，並在之後的收盤再次判斷出場。"
  },
  "factors": {
   "sources": [
    {
     "ref": "core/calc_indicators.py::build_feature_history",
     "sha256": "83afdba30b7493287b67aa7930489d7bae067cef58494509dd874edd72d2480e"
    },
    {
     "ref": "core/calc_indicators.py::calculate_rsi",
     "sha256": "00531a2fff38da1b1bcf88275b0b499d1ca9b878811567e34e88e0fa57c2d208"
    },
    {
     "ref": "config/settings.py::Config.RSI_PERIOD",
     "sha256": "b988e65b1c936dbdf008e87cc6d42d2b0fc646be25aad27f0cd2cdf7aac9e375"
    },
    {
     "ref": "core/calc_indicators.py::calculate_kd",
     "sha256": "8ec305a8b6fd2a76d5dfe848e2b5fbc3a4a3997b59711eb80aac6a15fb64181d"
    },
    {
     "ref": "config/settings.py::Config.KD_PERIOD",
     "sha256": "1563cf95eb802b1147e0064d69c0a7ca92dd0047428f840364e5c7247f373f67"
    }
   ],
   "text": "ma20、ma60 為 20 日與 60 日收盤均線（最少 10 與 30 筆）；rsi 為 14 期 RSI：100 − 100 ÷ (1 + 平均漲幅 ÷ 平均跌幅)，平均為簡單移動平均；kd_k 為 9 期 RSV（(收盤 − 9 日最低) ÷ (9 日最高 − 9 日最低) × 100）經 com=2 指數平滑的 K 值。規則另使用當日收盤價與成交量。"
  },
  "holdings": {
   "sources": [
    {
     "ref": "core/backtest/runner.py::MAX_HOLDINGS",
     "sha256": "1e92a92e5ce2a60e0b4b806554cf7dcc1d63733b9ca84af26b41c9d7452c2121"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine._get_max_holdings",
     "sha256": "2a2737386c61bb398f0ad2b1db0c9e3c96b96166f2f4afddc0b4efd69f2eea13"
    },
    {
     "ref": "config/settings.py::Config.NEWS_BEAR_MAX_HOLDINGS",
     "sha256": "fbc4a9925d7fc03f76d24fdec29818eb4acc0d146a2ca0596818a816c402806e"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.find_candidates",
     "sha256": "67e822acbfea6dd1d093cedf97b210205cb6e2b8340a93d27db36ad33bad29c7"
    },
    {
     "ref": "scripts/legacy_baseline_run.py::config_for",
     "sha256": "734494c0a430d3471c27d73eb6730b3ca392b2aa772274537ef56ec67109d207"
    }
   ],
   "text": "同時最多持有 3 檔（MAX_HOLDINGS）；若當日新聞情緒標記為「偏空」，上限降為 2 檔（Config.NEWS_BEAR_MAX_HOLDINGS）。每天只取選股結果的前 3 檔作為候選；歷史回測使用 rules_only，不套用 AI 模型排序，沿用策略自身的排序。"
  },
  "hypothesis": {
   "sources": [
    {
     "ref": "core/strategies/hybrid_trend_rank.py::HybridTrendRankStrategy.filter_candidates",
     "sha256": "fe5bd8626219fd79fbbf25fba7f2cdda784c3a0da0b73ec8acd8604a45baa283"
    },
    {
     "ref": "config/settings.py::Config.USE_KD_FILTER",
     "sha256": "653d67b63b9662f04019a89fa3103c00f32bb342a390ab59a8c3868169d564c0"
    }
   ],
   "text": "買進收盤價站上 20 日與 60 日均線、20 日均線高於 60 日均線、RSI 介於 40 與 70 之間、K 值低於 30 且成交量大的股票。其經濟想法是：中期上升趨勢中的股票出現短線回檔（K 值偏低）後，原有趨勢延續會帶動股價回升。"
  },
  "pit_dependencies": {
   "sources": [
    {
     "ref": "core/research/native_frame.py::NativeResearchData.cross_section",
     "sha256": "933b5b11365cc954da93c595ee304a97c3d2cadc7c32b49e5924be631b7d2eac"
    },
    {
     "ref": "core/research/native_frame.py::LOOKBACK_DAYS",
     "sha256": "5d38a196cc6060d0f54a2894d24e4d362581727a1cd7e845cb242a6949d5b571"
    },
    {
     "ref": "core/calc_indicators.py::build_feature_history",
     "sha256": "83afdba30b7493287b67aa7930489d7bae067cef58494509dd874edd72d2480e"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.execute_pending_open",
     "sha256": "bf05cceee31f3f6a56ec1793eac5b6cf8f7945a1693d358a5de0b7c9c8d65bb5"
    },
    {
     "ref": "core/research/native_frame.py::rule_inputs",
     "sha256": "02d1adf456a1248edbdb0964691d8ce9b04b38aec67363e76fe7687fc43cb676"
    },
    {
     "ref": "core/research/native_frame.py::NativeResearchData.frame",
     "sha256": "3ce86e434675a84475d911695a92e8575b6e318149fada890a5b0da7de428327"
    }
   ],
   "text": "只使用訊號日（含）以前的官方日線：研究橫截面只取 trade_date ≤ 訊號日、回看 150 個日曆日的資料計算指標，訊號日沒有官方資料時中止（NO_OFFICIAL_SESSION_DATA）。成交日必須晚於訊號日。選股規則只用價格與成交量；但 foreign_ratio、trust_ratio 屬於必要欄位，訊號日的三大法人買賣超必須已存在，股票才會進入橫截面。"
  },
  "rebalance": {
   "sources": [
    {
     "ref": "core/backtest/runner.py::BacktestEngine.process_close_signals",
     "sha256": "e4f0738b44d9a5f9a3331ae7641055228db124e2ef9dd0ecce4fbccf99202a13"
    },
    {
     "ref": "core/backtest/runner.py::BacktestEngine.check_and_execute_exit",
     "sha256": "de4e85bc4c258f17e5c1ec3aca7be67b4841db2bbfe2603242e9bf543e3a7cf5"
    }
   ],
   "text": "沒有固定日曆的換股。持股只在出場條件觸發後賣出；空出的名額在大盤趨勢為 BULL 的交易日，由當日新的候選股遞補。"
  },
  "risk_controls": {
   "sources": [
    {
     "ref": "core/strategies/hybrid_trend_rank.py::HybridTrendRankStrategy.stop_loss",
     "sha256": "f67691c33bac5cda21084eac893028089288dfe36d4f24ed7f8ba448a00b78c7"
