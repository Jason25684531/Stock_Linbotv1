# Local runtime example configuration
# Copy to .env for local overrides. Keep secrets out of git.

# Application database connection
DB_URL=mysql+pymysql://trader:trader_password@localhost:3306/stock_ai_db

# MCP service connection
MCP_BASE_URL=http://localhost:8080
MCP_DEFAULT_MARKET=ALL
MCP_HTTP_TIMEOUT_SECONDS=20
MCP_CONNECT_TIMEOUT_SECONDS=5
MCP_MAX_RETRIES=3
MCP_BACKOFF_BASE_SECONDS=1
MCP_MAX_BACKOFF_SECONDS=8
MCP_HEALTH_PATH=/health
APP_HEALTH_PATH=/health

# Model path contract
MODEL_PATH=ML_Data/pkl/stock_ai_model.pkl

# Daily lightweight backtest validation (Phase 2, conservative defaults)
ENABLE_DAILY_BACKTEST_VALIDATION=false
DAILY_BACKTEST_WINDOW_DAYS=60
DAILY_BACKTEST_STRATEGIES=v34_turbo
DAILY_BACKTEST_UNIVERSE=2330,2317,2454
DAILY_BACKTEST_INITIAL_CAPITAL=1000000

# Line Bot
LINE_TOKEN=your_line_channel_access_token
LINE_SECRET=your_line_channel_secret

# Google Gemini
GEMINI_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Dashboard auth
ADMIN_PASSWORD=your_admin_password_here
FLASK_SECRET_KEY=your_random_secret_key_here
