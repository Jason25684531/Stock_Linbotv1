# ==========================================
# 環境變數範本 (複製為 .env 後填入實際值)
# ==========================================
# ⚠️ 注意：.env 檔案已被 .gitignore 忽略，不會上傳到 Git

# 🗄️ 資料庫連線
DB_URL=mysql+pymysql://root:my_secret_password@localhost:3306/stock_ai_db

# 🌉 MCP 服務
MCP_BASE_URL=http://localhost:8080
MCP_DEFAULT_MARKET=ALL
MCP_HTTP_TIMEOUT_SECONDS=20
MCP_CONNECT_TIMEOUT_SECONDS=5
MCP_MAX_RETRIES=3
MCP_BACKOFF_BASE_SECONDS=1
MCP_MAX_BACKOFF_SECONDS=8
MCP_HEALTH_PATH=/health
APP_HEALTH_PATH=/health

# 🤖 AI 模型路徑
MODEL_PATH=ML_Data/pkl/stock_ai_model.pkl

# 🔑 Line Bot
LINE_TOKEN=your_line_channel_access_token
LINE_SECRET=your_line_channel_secret

# 🧠 Google Gemini (新聞情緒分析)
GEMINI_KEY=your_gemini_api_key

# 🔐 Web Dashboard 登入驗證 (Phase 1 Security)
ADMIN_PASSWORD=your_admin_password_here

# 🔒 Flask Secret Key (用於 Session 加密)
FLASK_SECRET_KEY=your_random_secret_key_here
